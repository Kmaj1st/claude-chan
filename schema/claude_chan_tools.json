[
  {
    "name": "claude_chan_act",
    "description": "Make the Claude-chan mascot play a motion, show an expression and/or say a short line. Use sparingly.",
    "inputSchema": {
      "type": "object",
      "properties": {
        "motion": {
          "type": "string",
          "enum": [
            "idle",
            "wave",
            "nod",
            "shake_head",
            "think",
            "happy",
            "surprised",
            "bow",
            "cheer",
            "sleepy",
            "typing",
            "tea_serve",
            "pout",
            "wink",
            "point"
          ],
          "description": "Preset motion to play."
        },
        "expression": {
          "type": "string",
          "enum": [
            "neutral",
            "smile",
            "sad",
            "angry",
            "blush",
            "surprised"
          ],
          "description": "Facial expression."
        },
        "say": {
          "type": "string",
          "minLength": 1,
          "maxLength": 280,
          "description": "Short speech bubble text (plain text)."
        },
        "duration": {
          "type": "integer",
          "minimum": 100,
          "maximum": 60000,
          "description": "Milliseconds the expression/bubble stays."
        },
        "priority": {
          "type": "string",
          "enum": [
            "low",
            "normal",
            "high",
            "urgent"
          ],
          "description": "Queue priority; higher interrupts lower. Default normal."
        }
      },
      "additionalProperties": false
    }
  },
  {
    "name": "claude_chan_say",
    "description": "Show a short speech bubble next to the mascot.",
    "inputSchema": {
      "type": "object",
      "properties": {
        "text": {
          "type": "string",
          "minLength": 1,
          "maxLength": 280
        }
      },
      "required": [
        "text"
      ],
      "additionalProperties": false
    }
  },
  {
    "name": "claude_chan_set_mood",
    "description": "Set the long-lived mood that colours idle behaviour.",
    "inputSchema": {
      "type": "object",
      "properties": {
        "mood": {
          "type": "string",
          "enum": [
            "neutral",
            "happy",
            "sad",
            "angry",
            "shy",
            "sleepy",
            "thinking"
          ]
        }
      },
      "required": [
        "mood"
      ],
      "additionalProperties": false
    }
  },
  {
    "name": "claude_chan_set_state",
    "description": "Report what the agent is doing (idle, thinking, working, success, error ...); the mascot reacts with a fitting motion, expression and mood.",
    "inputSchema": {
      "type": "object",
      "properties": {
        "state": {
          "type": "string",
          "enum": [
            "idle",
            "listening",
            "thinking",
            "working",
            "waiting",
            "speaking",
            "success",
            "error",
            "sleeping"
          ]
        }
      },
      "required": [
        "state"
      ],
      "additionalProperties": false
    }
  },
  {
    "name": "claude_chan_list_motions",
    "description": "List available motions, expressions, moods and priorities.",
    "inputSchema": {
      "type": "object",
      "properties": {},
      "additionalProperties": false
    }
  }
]
