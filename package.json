{
 "name": "claude-chan",
 "version": "0.1.0",
 "description": "Claude-chan: embeddable Live2D mascot with tool-call driven motions",
 "private": true,
 "type": "module",
 "license": "UNLICENSED",
 "main": "./dist/claude-chan.js",
 "module": "./dist/claude-chan.js",
 "types": "./dist/index.d.ts",
 "exports": {
  ".": {
   "types": "./dist/index.d.ts",
   "import": "./dist/claude-chan.js"
  },
  "./schema": "./schema/claude_chan_act.json",
  "./motions.json": "./src/model/motions.default.json"
 },
 "files": [
  "dist",
  "schema",
  "server/dist",
  "docs"
 ],
 "bin": {
  "claude-chan-mcp": "./server/dist/cli.js"
 },
 "scripts": {
  "dev": "vite",
  "build": "tsc --noEmit && vite build",
  "typecheck": "tsc --noEmit",
  "test": "vitest run",
  "test:e2e": "node tests/e2e/run.mjs"
 },
 "devDependencies": {
  "@types/node": "^22.0.0",
  "@types/ws": "^8.18.2",
  "typescript": "^5.6.0",
  "vite": "^6.0.0",
  "vitest": "^2.1.0"
 },
 "dependencies": {
  "@modelcontextprotocol/sdk": "^1.32.2",
  "ws": "^8.22.0",
  "zod": "^4.6.7"
 }
}
