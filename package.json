{
 "name": "claude-chan",
 "version": "0.1.0",
 "description": "Claude-chan: an embeddable anime mascot (sprites or Live2D) driven by AI tool calls via MCP, WebSocket, postMessage or text markers",
 "private": true,
 "type": "module",
 "license": "MIT",
 "author": "Kmaj1st",
 "repository": { "type": "git", "url": "git+https://github.com/Kmaj1st/claude-chan.git" },
 "homepage": "https://github.com/Kmaj1st/claude-chan#readme",
 "bugs": { "url": "https://github.com/Kmaj1st/claude-chan/issues" },
 "keywords": ["mascot", "live2d", "anime", "web-component", "mcp", "ai-agent", "claude", "sprite", "postmessage", "userscript"],
 "main": "./dist/claude-chan.js",
 "module": "./dist/claude-chan.js",
 "types": "./dist/index.d.ts",
 "exports": {
  ".": {
   "types": "./dist/index.d.ts",
   "import": "./dist/claude-chan.js"
  },
  "./schema": "./schema/claude_chan_act.json",
 "./schema/tools": "./schema/claude_chan_tools.json",
  "./motions.json": "./src/model/motions.default.json"
 },
 "files": [
  "dist",
  "schema",
 "assets",
  "server/dist",
 "src/model/motions.default.json",
  "docs"
 ],
 "bin": {
  "claude-chan-mcp": "./server/dist/cli.js"
 },
 "scripts": {
  "dev": "vite",
  "build": "tsc --noEmit && vite build && npm run build:types && npm run build:server",
 "build:types": "tsc -p tsconfig.build.json",
  "build:server": "esbuild server/cli.ts --bundle --platform=node --format=esm --target=node20 --packages=external --outfile=server/dist/cli.js",
  "vendor": "node scripts/vendor.mjs",
 "typecheck": "tsc --noEmit",
  "test": "vitest run",
 "check:links": "node scripts/check-links.mjs",
  "test:e2e": "node tests/e2e/run.mjs",
 "test:live2d": "node tests/e2e/live2d.mjs",
 "build:loader": "node scripts/build-loader.mjs",
 "check:loader": "node scripts/build-loader.mjs --check",
 "serve:loader": "node scripts/serve-loader.mjs",
 "test:loader": "node scripts/build-loader.mjs && node tests/e2e/loader.mjs",
 "check:model": "esbuild server/check-model.ts --bundle --platform=node --format=esm --target=node20 --packages=external --outfile=server/dist/check-model.js && node server/dist/check-model.js"
 },
 "devDependencies": {
  "@types/node": "^22.0.0",
  "@types/ws": "^8.18.2",
  "esbuild": "^0.28.2",
  "pixi-live2d-display": "0.4.0",
  "pixi.js": "6.5.10",
  "puppeteer-core": "^25.16.0",
  "sharp": "^0.35.5",
  "typescript": "^5.6.0",
  "vite": "^6.0.0",
  "vitest": "^2.1.0"
 },
 "dependencies": {
  "@modelcontextprotocol/sdk": "^1.32.2",
  "ws": "^8.22.0",
  "zod": "^4.6.7"
 }
}
